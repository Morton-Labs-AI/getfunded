# Read-only pool for every page: a login that is IN ROLE greenbook_ro (corpus
# migration 0036) over the Supabase session pooler (NOT the direct IPv6 host).
# greenbook_ro is read-only at the role level with a 15 s statement timeout.
# Never the postgres owner, and not funder_ro: since web migration
# getfunded_0010 that role sees only the analyst's allowlist. Operator step:
#   create role greenbook_login login password '...' in role greenbook_ro;
DATABASE_URL=postgresql://greenbook_login.<project-ref>:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
CHAT_EFFORT=medium

# Voyage AI — query-side embeddings for semantic_funder_search.
# Same key as corpus/ (VOYAGE_API_KEY in corpus/.env). Required for thematic funder discovery.
VOYAGE_API_KEY=

# Admin surface (labeling + enrichment). Set to 1 ONLY on a local machine or a
# separately access-controlled staging deployment. Unset (the default) means
# lib/admin/db.ts refuses to load, every /api/admin route 403s, and every page
# under /admin 404s via app/admin/layout.tsx.
#
# This replaced a NODE_ENV !== "development" test: keying a security property
# to build mode meant the production branch could never be exercised in a test.
ADMIN_ENABLED=

# Admin write connection: write-capable DIRECT-HOST (IPv6) connection for the
# /admin routes. MUST be the funder_rw role, never postgres/superuser — these
# flows write five tables and need no DDL. See migration 0022_roles.sql.
ADMIN_DATABASE_URL=

# Website enrichment (dev-only): absolute path to corpus/data/raw in this
# repository — snapshots land in $FUNDERDB_RAW_DIR/funder_website/. The fetch
# route refuses to register snapshots when unset.
# Also powers the read-only raw-XML view on /filing/[objectId]/xml, which
# streams the original IRS e-file straight out of the staged batch zips
# ($FUNDERDB_RAW_DIR/irs_990_xml/). Unset → the "view raw XML" link hides.
FUNDERDB_RAW_DIR=/absolute/path/to/getfunded/corpus/data/raw
