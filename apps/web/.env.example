# GetFunded web app — environment
#
# Copy to .env.local for development. Every variable is documented in
# docs/ARCHITECTURE.md ("Environment"). Never commit a real .env* file.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# The app connection: role getfunded_login over the Supabase SESSION pooler
# (port 5432; the pooler username is <role>.<project-ref>). The app reads the
# corpus plane and writes getfunded.* under Row Level Security through it.
#
# OPERATOR NOTE — creating getfunded_login (once per database, as postgres):
#   The migrations create getfunded_app as a NOLOGIN role with every grant the
#   app needs. The app never logs in as getfunded_app directly; it logs in as a
#   thin login role that inherits it:
#
#     create role getfunded_login login password '<long random password>'
#       in role getfunded_app;
#
#   Do NOT use postgres, service_role or funder_ro here. If the pooler is in
#   transaction mode (port 6543) keep DATABASE_URL on the session pooler anyway;
#   the app already disables prepared statements for pooler compatibility.
DATABASE_URL=postgresql://getfunded_login.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Migrations and the demo seed only (npm run db:migrate, npm run seed:demo).
# Must be the object OWNER with BYPASSRLS (the postgres role on Supabase, a
# superuser elsewhere), never getfunded_login. Leave empty to fall back to
# DATABASE_URL. Never put this URL in a deployed app's environment.
MIGRATE_DATABASE_URL=

# "Ask the analyst" only: role funder_ro, read-only at the role level with a
# 15 s statement timeout. The ONLY connection that runs model-written SQL.
# Leave empty to disable the feature with a visible notice.
ANALYST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Identity (required) — Supabase Auth, magic link + 6-digit code
# ---------------------------------------------------------------------------

# Session only. The app never reads data through PostgREST and never holds the
# service_role key. Use the anon (publishable) key here; the app refuses a
# secret key.
#
# Supabase dashboard checklist:
#   Authentication → URL Configuration: add APP_URL/auth/callback to Redirect URLs.
#   Authentication → Email Templates → Magic Link: include {{ .Token }} in the
#   body (alongside {{ .ConfirmationURL }}) so the 6-digit code alternative works.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of this deployment, used for email links and same-origin
# checks. No trailing slash. Development: http://localhost:3050
APP_URL=http://localhost:3050

# Comma-separated steward logins allowed under /admin. Empty = no admin surface.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI (for AI features)
# ---------------------------------------------------------------------------

# The steward's (hosted) or the self-host operator's own key. Only
# lib/ai/client.ts reads it, and only through meter().
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: claude-sonnet-5-5 and claude-opus-5-5.
AI_MODEL_FAST=
AI_MODEL_DEEP=

# Required by Anthropic only when ANTHROPIC_API_KEY is a user key
# (sk-ant-usr-...). Sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=

# Kill switch. "false" refuses every model call for everyone and shows a notice.
AI_ENABLED=true

# "mock" swaps the live model for a deterministic, token-free client (local
# development and end-to-end tests). Mock output is stored with is_mock=true and
# is never reused for a real request. Leave empty in production.
AI_MODE=

# Query embeddings for semantic search (voyage-3.5 at 512 dims, matching the
# index). Empty = keyword search with a visible notice.
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Billing (hosted only — leave empty when SELF_HOSTED=true)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=

# "true" puts every workspace on the internal unlimited plan and hides billing.
SELF_HOSTED=false

# npm run seed:demo only (self-host): email of a user who has signed in once;
# they own the "Demo Food Bank" workspace. `-- --owner <email>` overrides it.
DEMO_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Bearer token the scheduler (Vercel Cron via vercel.json, or any cron) sends
# to /api/cron/daily and /api/cron/signals. Empty = both endpoints answer 503
# and the daily maintenance and funder-signal alert jobs are off. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Integrations (for Gmail sending, Pro and above)
# ---------------------------------------------------------------------------

# 32-byte base64 key for AES-256-GCM encryption of integration tokens.
# Generate with: openssl rand -base64 32
SECRETS_KEY=

# Google OAuth client for sending outreach through the user's own Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting behind a proxy
# ---------------------------------------------------------------------------

# "true" when this app sits behind a reverse proxy you control (nginx, Caddy,
# a load balancer) that sets X-Forwarded-For / X-Real-IP. Then the client
# address is read from those headers for per-IP rate limits. Vercel is trusted
# automatically (it sets VERCEL=1). Leave unset when the app faces clients
# directly: a client-written X-Forwarded-For would otherwise choose its own
# rate-limit bucket. When unset off Vercel, every anonymous visitor shares one
# rate-limit bucket, so set it on any self-hosted install behind a proxy.
TRUST_PROXY=
