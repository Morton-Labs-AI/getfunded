# Supabase session pooler (NOT the direct IPv6 host — the pooler handles many
# short app queries; user is postgres.<project-ref>).
DATABASE_URL=postgresql://postgres.poznaikbjcgnthfmqueo:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
CHAT_EFFORT=medium

# Voyage AI — query-side embeddings for semantic_funder_search.
# Same key as the data repo. Required for thematic funder discovery.
VOYAGE_API_KEY=

# Admin surface (labeling + enrichment). Set to 1 ONLY on a local machine or a
# separately access-controlled staging deployment. Unset (the default) means
# lib/admin/db.ts refuses to load, every /api/admin route 403s, and every page
# under /admin 404s via app/admin/layout.tsx.
#
# This replaced a NODE_ENV !== "development" test: keying a security property
# to build mode meant the production branch could never be exercised in a test.
ADMIN_ENABLED=

# Admin write connection: write-capable DIRECT-HOST (IPv6) connection for the
# /admin routes. MUST be the funder_rw role, never postgres/superuser — these
# flows write five tables and need no DDL. See migration 0022_roles.sql.
ADMIN_DATABASE_URL=

# Website enrichment (dev-only): absolute path to the DATA repo's data/raw
# directory — snapshots land in $FUNDERDB_RAW_DIR/funder_website/. The fetch
# route refuses to register snapshots when unset.
# Also powers the read-only raw-XML view on /filing/[objectId]/xml, which
# streams the original IRS e-file straight out of the staged batch zips
# ($FUNDERDB_RAW_DIR/irs_990_xml/). Unset → the "view raw XML" link hides.
FUNDERDB_RAW_DIR=/absolute/path/to/open-funder-db/data/raw

# ---------------------------------------------------------------------------
# COMMUNITY LAYER (migrations/community_00NN_*.sql)
# ---------------------------------------------------------------------------

# Supabase Auth. The auth.users table lives in THIS Postgres, which is the
# whole reason Supabase Auth was chosen: community.members.auth_user_id is a
# local join key, not a cross-system lookup. Supabase is the SESSION layer
# only — the client is built per request, only auth.* is ever called, and
# PostgREST is never touched. All data access stays on postgres.js.
NEXT_PUBLIC_SUPABASE_URL=https://poznaikbjcgnthfmqueo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The APPLICATION pool: role community_app (migration community_0001).
# SELECT on internal.*, full DML on community.*, and ZERO write grants on the
# corpus — that absence is the one-way-flow guarantee, and scripts/db-ping.mjs
# asserts it on every run.
#
# MUST NOT be funder_ro (it is read-only at the role level and is the pool that
# runs model-generated SQL) and MUST NOT be postgres/superuser.
#
# NOTE, operator step: community_app is created NOLOGIN, per 0022 doctrine.
# Before this URL can work, someone must attach LOGIN + a password out of band,
# or create a community_login role IN ROLE community_app. The pooler username
# format is <role>.<project-ref>.
#
# Unset (the default) means: the community pool falls back to DATABASE_URL, the
# app builds and every corpus page renders exactly as today, community reads
# soft-fail to empty, and community writes fail loudly.
COMMUNITY_DATABASE_URL=

# Community posture. Controls PRESENTATION only — the nav badge, robots, and
# whether member surfaces render. WHO ACTUALLY GETS IN is the `signup_mode` row
# in community.settings, enforced in Postgres by community.may_sign_up().
# A hidden link is not a gate; these two are deliberately separate.
#
#   off     (default) no community surfaces; badge stays "read-only · local"
#   invite  logins live, signup gated by community.invites/allowlist_domains
#   open    public signup; corpus routes become indexable, member routes never
COMMUNITY_MODE=off
