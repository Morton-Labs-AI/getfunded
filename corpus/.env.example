# Direct Postgres connection (db.<ref>.supabase.co is IPv6-only; requires an
# IPv6-routed network). Preferred for bulk COPY loads — the session pooler
# (aws-0-us-east-1.pooler.supabase.com:5432, user postgres.<ref>) intermittently
# fails large COPY streams with "SSL error: bad record mac"; use it only as a
# fallback on IPv4-only networks, with chunked loads.
# Password: Supabase dashboard -> project open-funder-db -> Settings -> Database.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.poznaikbjcgnthfmqueo.supabase.co:5432/postgres

# Where staged raw files land (gitignored; hash-registered in internal.raw_files).
DATA_ROOT=./data

# SEC requires a declared User-Agent for sec.gov downloads.
SEC_USER_AGENT="MortonLabs zach@mortonlabs.ai"

# Voyage AI — semantic-search embeddings (voyage-3.5 @ 512 dims).
# Required for `funderdb embed sync`. Create at voyageai.com.
VOYAGE_API_KEY=
