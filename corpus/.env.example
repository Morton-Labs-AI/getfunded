# Open Funder Database — environment file.
# Copy to .env and fill in. Every variable the pipeline reads is listed here;
# an unset optional variable simply turns that feature off.

# ---- Required for anything that writes to the database ----------------------
# Postgres connection string. The loaders use COPY, which needs a SESSION-mode
# connection (a transaction pooler such as pgbouncer on port 6543 will not do).
#   local Docker (docs/SELF-INSTALL.md):
#     postgresql://funderdb:funderdb@localhost:5432/funderdb
#   Supabase: Settings -> Database -> Connection string, "Session" mode, or the
#     direct host db.<project-ref>.supabase.co:5432 (IPv6-only).
DATABASE_URL=

# ---- Optional ---------------------------------------------------------------
# Where staged raw files, exports and run manifests land (gitignored).
DATA_ROOT=./data

# Directory holding the numbered *.sql migrations. Default: <repo>/migrations.
# MIGRATIONS_DIR=./migrations

# sec.gov requires every automated client to declare its organisation and a
# contact e-mail (https://www.sec.gov/os/accessing-edgar-data). There is NO
# default: `ingest adv`, `ingest adv-schedules` and `ingest formd` refuse to
# run until this names YOUR organisation and YOUR address.
SEC_USER_AGENT="Example Nonprofit data@example.org"

# User-Agent for every other download (IRS, SBIR, ProPublica parity check).
# The default identifies the tool; name your organisation if you prefer.
# HTTP_USER_AGENT="funderdb/0.1 (Example Nonprofit; data@example.org)"

# Voyage AI key for semantic-search embeddings (`funderdb embed sync`).
# Every ingest, export and benchmark works without it. Create at voyageai.com.
VOYAGE_API_KEY=

# Funder signals (`funderdb signals ...`, migration 0032). Classification calls
# Claude; leave the key empty and set SIGNALS_AI_MODE=mock for a token-free
# keyword classifier (rows are marked extraction_model='mock' and never
# auto-publish).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
SIGNALS_AI_MODE=live
